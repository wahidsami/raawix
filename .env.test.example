# Test Environment configuration for RaawiX
# Copy to .env.test and DO NOT commit .env.test

# Database Configuration (matches docker-compose.test.yml)
DATABASE_URL=postgresql://test_user:test_password@127.0.0.1:5433/raawix_test?schema=public

# Redis Configuration for BullMQ
REDIS_URL=redis://127.0.0.1:6380

# API & Scanner configuration
PORT=3002
NODE_ENV=test
OUTPUT_DIR=./test_output
MAX_CONCURRENT_SCANS=2
ALLOW_LOCALHOST=true
